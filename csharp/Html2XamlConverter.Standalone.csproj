<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Html2XamlConverter</AssemblyName>
    <Version>2.0.0</Version>
    <Authors>onlyone1-phoenix</Authors>
    <Description>Enhanced HTML to XAML converter application with modern .NET 8 support</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.61" />
    <PackageReference Include="AngleSharp" Version="0.17.1" />
    <PackageReference Include="ExCSS" Version="4.2.3" />
  </ItemGroup>

</Project>
